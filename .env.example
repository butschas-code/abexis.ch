# Public site routing (single deployment; keep `abexis`)
NEXT_PUBLIC_CMS_SITE_ID=abexis

# Firebase Web SDK (browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (server)
# Option A: Full JSON string
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: Individual fields (recommended for Vercel)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# Required when running `pnpm cms:optimize-storage-media` with NODE_ENV=production (explicit consent).
# CMS_OPTIMIZE_STORAGE_ALLOW=1
FIREBASE_WEB_API_KEY=

# Blog automation — Vercel Cron is only a background reconciliation/draft-preparation check.
# Exact public publishing is driven by each post's `publishedAt`; Nuelink is scheduled at approval time.
OPENAI_API_KEY=
# Unsplash — server-only key for blog automation hero search (`UNSPLASH_ACCESS_KEY`). Never expose to the client.
UNSPLASH_ACCESS_KEY=
# Random secret; Vercel Cron sends Authorization: Bearer <CRON_SECRET> when set on the project.
CRON_SECRET=
# Optional override (default: gpt-4.1-mini — mini tier listed for Responses API web search). Structured outputs require a compatible model.
# OPENAI_BLOG_MODEL=gpt-4.1-mini
# Optional override: Firestore `authors` doc id for AI blog posts. If unset, the CMS prefers the author named Daniel Sengstag.
# BLOG_AUTOMATION_DEFAULT_AUTHOR_ID=

# Nuelink — server-only handoff from reviewed CMS social posts.
# Create an API key in Nuelink, then set the Abexis brand id and the collection that contains Daniel Sengstag's LinkedIn profile.
NUELINK_API_KEY=
NUELINK_BRAND_ID=
NUELINK_COLLECTION_ID=
NUELINK_LINKEDIN_PROFILE_URL=https://ch.linkedin.com/in/danielsengstag/de
# Optional: QUEUE (default), DRAFT, IMMEDIATE, or SCHEDULE. For SCHEDULE also set NUELINK_SCHEDULED_AT as "YYYY-MM-DD HH:mm:ss".
# NUELINK_PUBLISH_MODE=QUEUE
# NUELINK_SCHEDULED_AT=

# CMS custom TOTP (no Firebase Identity Platform). Long random string; rotate if leaked.
CMS_MFA_COOKIE_SECRET=
# Optional: issuer label shown in authenticator apps (default: Abexis CMS).
# CMS_MFA_ISSUER=

# Formspark + Cloudflare Turnstile
# Configure the matching Turnstile secret in each Formspark form dashboard.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
FORMSPARK_CONTACT_FORM_ID=
FORMSPARK_APPLICATION_FORM_ID=

# Optional local Firebase emulators
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
